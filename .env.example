# Configuration Garmin Connect (Optionnel : peut aussi être saisi directement dans l'interface Web)
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Stratégies de connexion garminconnect à ignorer (accélère la connexion en évitant celles
# systématiquement rate-limitées/429 pour beaucoup d'IP avant de retomber sur le SSO qui marche).
# Valeurs possibles : mobile+cffi, mobile+requests, widget+cffi, portal+cffi, portal+requests.
# Laisser vide pour retenter toutes les stratégies (plus lent mais plus robuste).
GARMIN_SKIP_LOGIN_STRATEGIES=mobile+cffi,mobile+requests

# Configuration API Strava (Créer une application sur https://www.strava.com/settings/api)
# Callback URL recommandée dans vos paramètres Strava : http://localhost:8000/api/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Configuration du serveur Web
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-me-to-a-secure-random-string
# Passer à true si le serveur tourne derrière un reverse-proxy HTTPS en production
COOKIE_SECURE=false

# Configuration de la base de données PostgreSQL
# DATABASE_URL prend le pas sur les variables PG* individuelles si elle est définie.
# N'utilisez jamais un compte superutilisateur (root/postgres) pour l'app : créez un
# rôle applicatif dédié avec des droits limités à sa propre base (voir README > PostgreSQL).
DATABASE_URL=postgresql://garmin_strava_app:changeme@localhost:5432/garmin_strava
# Alternative : variables déclarées séparément (utilisées uniquement si DATABASE_URL est vide)
PGHOST=localhost
PGPORT=5432
PGDATABASE=garmin_strava
PGUSER=garmin_strava_app
PGPASSWORD=changeme
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=10
